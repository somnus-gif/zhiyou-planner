/* pages/flight/query/query.wxss */
.page { min-height: 100vh; background: #F5F7FA; padding-bottom: 140rpx; }
.state-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-text { color: #8C8C8C; font-size: 28rpx; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx; }
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

.form-card { background: #fff; margin: 24rpx 32rpx; padding: 32rpx 28rpx; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(27,160,215,0.06); }
.trip-type-row { display: flex; gap: 24rpx; margin-bottom: 28rpx; }
.tt-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #F5F7FA; color: #595959; font-size: 28rpx; }
.tt-on { background: #1BA0D7; color: #fff; }

.route-row { display: flex; align-items: flex-end; gap: 16rpx; margin-bottom: 24rpx; }
.route-col { flex: 1; }
.route-label { display: block; font-size: 22rpx; color: #8C8C8C; margin-bottom: 8rpx; }
.route-code { font-size: 44rpx; font-weight: 600; color: #1A1A1A; padding: 8rpx 0; border-bottom: 2rpx solid #1BA0D7; }
.route-code.placeholder { color: #BFBFBF; font-weight: 400; font-size: 32rpx; }
.swap-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: #1BA0D71A; color: #1BA0D7; font-size: 24rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; }
.swap-btn:active { transform: scale(0.92); }

.date-row { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.date-col { flex: 1; }
.date-label { display: block; font-size: 22rpx; color: #8C8C8C; margin-bottom: 8rpx; }
.date-val { font-size: 30rpx; color: #1A1A1A; padding: 12rpx 0; border-bottom: 1rpx solid #E5E5E5; }
.date-val.placeholder { color: #BFBFBF; }

.search-btn { background: linear-gradient(135deg, #1BA0D7, #1781AC); color: #fff; text-align: center; padding: 22rpx 0; border-radius: 48rpx; font-size: 30rpx; font-weight: 500; }
.search-btn.disabled { opacity: 0.6; }
.search-btn:active { transform: scale(0.98); }.result-area { padding: 0 32rpx; }
.result-head { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.result-title { font-size: 26rpx; color: #595959; }
.result-tip { font-size: 22rpx; color: #BFBFBF; }

.flight-empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-illu { width: 96rpx; height: 96rpx; border-radius: 50%; border: 4rpx dashed #BFBFBF; color: #BFBFBF; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #8C8C8C; }

.flight-card { position: relative; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; border: 2rpx solid transparent; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.flight-card.selected { border-color: #1BA0D7; box-shadow: 0 4rpx 16rpx rgba(27,160,215,0.16); }

.flight-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.airline { font-size: 26rpx; color: #595959; }
.price-box { display: flex; align-items: baseline; color: #FF6B1A; }
.price-symbol { font-size: 22rpx; }
.price-num { font-size: 36rpx; font-weight: 700; }

.time-row { display: flex; align-items: center; padding: 8rpx 0 16rpx; }
.time-col { flex: 1; }
.time-val { display: block; font-size: 38rpx; font-weight: 600; color: #1A1A1A; }
.airport-name { font-size: 22rpx; color: #8C8C8C; }
.time-arrow { color: #BFBFBF; font-size: 32rpx; padding: 0 24rpx; }

.meta-row { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.meta-tag { padding: 4rpx 14rpx; background: #F5F7FA; color: #595959; border-radius: 16rpx; font-size: 22rpx; }
.meta-stock { margin-left: auto; color: #07C160; font-size: 22rpx; }
.selected-flag { position: absolute; top: 0; right: 0; background: #1BA0D7; color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 0 16rpx 0 12rpx; }

.action-bar { padding: 24rpx 32rpx; }
.btn { text-align: center; padding: 22rpx 0; border-radius: 48rpx; font-size: 30rpx; }
.btn-danger-outline { color: #FF4D4F; border: 2rpx solid #FF4D4F; }

.safe-bottom { height: env(safe-area-inset-bottom); }
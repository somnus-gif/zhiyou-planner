<!-- pages/customer/edit/edit.wxml -->
<view class="page">

  <view class="section">
    <view class="section-title">基本信息</view>
    <view class="form-card">
      <view class="form-row">
        <text class="label">姓名</text>
        <input class="value" type="text" placeholder="客户姓名" data-field="name"
               value="{{form.name}}" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">手机号</text>
        <input class="value" type="number" placeholder="11 位手机号" maxlength="11" data-field="phone"
               value="{{form.phone}}" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">微信号</text>
        <input class="value" type="text" placeholder="选填" data-field="wechat"
               value="{{form.wechat}}" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">客源</text>
        <picker mode="selector" range="{{sourceOptions}}" value="{{sourcePickerIndex}}" bindchange="onSourceChange">
          <view class="value {{form.source ? '' : 'placeholder'}}">{{form.source || '请选择客源'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="label">当前阶段</text>
        <picker mode="selector" range="{{stageOptions}}" range-key="label" value="{{stagePickerIndex}}" bindchange="onStageChange">
          <view class="value">{{stageOptions[stagePickerIndex].label}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">偏好标签</view>
    <view class="form-card">
      <view class="pref-grid">
        <view class="pref-chip {{form.preferences.indexOf(item) >= 0 ? 'active' : ''}}"
              wx:for="{{preferenceOptions}}" wx:key="*this"
              data-pref="{{item}}" bindtap="onPrefTap">{{item}}</view>
      </view>
      <view class="pref-custom-list" wx:if="{{form.preferences.length}}">
        <text class="pref-custom-label">已选：</text>
        <text class="pref-custom-text">{{form.preferences}}</text>
      </view>
      <view class="pref-add" bindtap="onAddCustomPref">+ 添加自定义</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">出行需求</view>
    <view class="form-card">
      <view class="form-row">
        <text class="label">预算</text>
        <input class="value" type="digit" placeholder="元" data-field="budget"
               value="{{form.budget}}" bindinput="onInput" />
        <text class="unit">元</text>
      </view>
      <view class="form-row">
        <text class="label">出发日期</text>
        <picker mode="date" value="{{form.travelStart}}" data-field="travelStart" bindchange="onDateChange">
          <view class="value {{form.travelStart ? '' : 'placeholder'}}">{{form.travelStart || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="label">返回日期</text>
        <picker mode="date" value="{{form.travelEnd}}" data-field="travelEnd" bindchange="onDateChange">
          <view class="value {{form.travelEnd ? '' : 'placeholder'}}">{{form.travelEnd || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-row pax-row">
        <text class="label">人数</text>
        <view class="pax-inputs">
          <input class="pax-input" type="number" placeholder="成人" data-field="adult"
                 value="{{form.adult}}" bindinput="onInput" />
          <input class="pax-input" type="number" placeholder="儿童" data-field="child"
                 value="{{form.child}}" bindinput="onInput" />
          <input class="pax-input" type="number" placeholder="婴儿" data-field="baby"
                 value="{{form.baby}}" bindinput="onInput" />
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">想去景点</view>
    <view class="form-card">
      <textarea class="textarea" placeholder="多个景点用逗号分隔，如：玉龙雪山，丽江古城，蓝月谷"
                data-field="scenicWishText" value="{{form.scenicWishText}}" bindinput="onInput"
                auto-height maxlength="200" />
    </view>
  </view>

  <view class="section" wx:if="{{!isEdit}}">
    <view class="section-title">首次沟通备注</view>
    <view class="form-card">
      <textarea class="textarea" placeholder="可选，记录首次沟通的关键信息"
                data-field="firstNote" value="{{form.firstNote}}" bindinput="onInput"
                auto-height maxlength="500" />
    </view>
  </view>

  <view style="height: 160rpx"></view>
  <view class="footer-bar safe-bottom">
    <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : (isEdit ? '保存修改' : '创建客户')}}
    </view>
  </view>
</view>

/* pages/flight/list/list.wxss */
.page { min-height: 100vh; padding-bottom: 120rpx; }
.list-area { padding-top: 8rpx; }
.state-box { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.skeleton-card { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; }
.sk-line { height: 32rpx; background: #F0F2F5; border-radius: 8rpx; }
.sk-title { width: 50%; margin-bottom: 16rpx; }
.sk-sub { width: 70%; }
.empty-illu { width: 96rpx; height: 96rpx; border-radius: 50%; border: 4rpx dashed #BFBFBF; color: #BFBFBF; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #595959; }
.empty-tip { font-size: 24rpx; color: #8C8C8C; margin-top: 8rpx; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx; }
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }.flight-item { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(27,160,215,0.06); }
.flight-item:active { background: #F5F7FA; }
.item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.route-text { font-size: 38rpx; font-weight: 600; color: #1A1A1A; }
.date-text { font-size: 24rpx; color: #8C8C8C; }
.item-body { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; padding: 12rpx 0; border-top: 1rpx solid #F0F2F5; }
.selected-label { padding: 4rpx 12rpx; background: #1BA0D71A; color: #1BA0D7; border-radius: 12rpx; font-size: 22rpx; }
.selected-flight { font-size: 26rpx; color: #1A1A1A; }
.selected-time { font-size: 24rpx; color: #595959; }
.selected-price { margin-left: auto; font-size: 30rpx; font-weight: 600; color: #FF6B1A; }
.item-body.unselected { color: #8C8C8C; }
.opt-count { font-size: 24rpx; color: #8C8C8C; }
.item-meta { margin-top: 8rpx; color: #BFBFBF; font-size: 22rpx; }
.load-more { text-align: center; color: #BFBFBF; font-size: 24rpx; padding: 24rpx 0; }
.fab { position: fixed; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom)); width: 104rpx; height: 104rpx; border-radius: 50%; background: linear-gradient(135deg, #1BA0D7, #1781AC); color: #fff; font-size: 56rpx; font-weight: 300; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(27,160,215,0.4); z-index: 100; }
.fab:active { transform: scale(0.92); }
.safe-bottom { height: env(safe-area-inset-bottom); }
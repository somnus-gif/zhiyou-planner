/* pages/quote/list/list.wxss */
.page { min-height: 100vh; padding-bottom: 120rpx; }

.status-tabs { white-space: nowrap; padding: 16rpx 24rpx 8rpx; background: #fff; position: sticky; top: 0; z-index: 10; }
.status-tab {
  display: inline-flex; align-items: center;
  padding: 10rpx 28rpx; margin-right: 16rpx;
  border: 1rpx solid currentColor;
  border-radius: 32rpx; font-size: 26rpx; background: #fff;
}
.status-tab.active { color: #fff; }

.list-area { padding-top: 8rpx; }
.state-box { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }

.skeleton-card { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; }
.sk-line { height: 32rpx; background: #F0F2F5; border-radius: 8rpx; }
.sk-title { width: 40%; margin-bottom: 16rpx; }
.sk-sub { width: 70%; }

.empty-illu {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 4rpx dashed #BFBFBF; color: #BFBFBF;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; margin-bottom: 24rpx;
}
.empty-text { font-size: 30rpx; color: #595959; }
.empty-tip { font-size: 24rpx; color: #8C8C8C; margin-top: 8rpx; }

.err-illu {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #FFF1F0; color: #FF4D4F;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx;
}
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

.quote-card { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(27,160,215,0.06); }
.quote-card:active { background: #F5F7FA; }
.quote-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.quote-version { font-size: 26rpx; color: #1BA0D7; font-weight: 600; background: #1BA0D714; padding: 4rpx 16rpx; border-radius: 8rpx; }
.quote-items-count { font-size: 24rpx; color: #8C8C8C; margin-left: 16rpx; }
.status-tag { margin-left: auto; padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }

.quote-body { display: flex; padding: 16rpx 0; border-top: 1rpx solid #F0F2F5; border-bottom: 1rpx solid #F0F2F5; }
.quote-total { flex: 1; }
.quote-profit { flex: 1; padding-left: 24rpx; border-left: 1rpx solid #F0F2F5; }
.total-label, .profit-label { display: block; font-size: 22rpx; color: #8C8C8C; margin-bottom: 6rpx; }
.total-amount { font-size: 34rpx; color: #1A1A1A; font-weight: 600; }
.profit-amount { font-size: 30rpx; color: #FF9F2C; font-weight: 500; }

.quote-meta { margin-top: 12rpx; }
.meta-time { color: #BFBFBF; font-size: 22rpx; }

.load-more { text-align: center; color: #BFBFBF; font-size: 24rpx; padding: 24rpx 0; }

.fab {
  position: fixed; right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, #1BA0D7, #1781AC);
  color: #fff; font-size: 56rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(27,160,215,0.4);
  z-index: 100;
}
.fab:active { transform: scale(0.92); }

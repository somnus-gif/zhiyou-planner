/* pages/customer/detail/detail.wxss */
.page { min-height: 100vh; padding-bottom: 40rpx; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.loading-text { color: #8C8C8C; font-size: 28rpx; }
.err-illu {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #FFF1F0; color: #FF4D4F;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx;
}
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

.hero { padding: 40rpx 32rpx 32rpx; color: #fff; }
.hero-row { display: flex; align-items: center; }
.hero-avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  color: #fff; font-size: 48rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.hero-info { flex: 1; margin-left: 24rpx; overflow: hidden; }
.hero-name { font-size: 40rpx; font-weight: 600; }
.hero-phone { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.hero-stage { padding: 10rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 500; flex-shrink: 0; }
.hero-meta { margin-top: 24rpx; font-size: 24rpx; opacity: 0.9; }
.meta-item { margin-right: 24rpx; }
.hero-lost { margin-top: 16rpx; padding: 16rpx 20rpx; background: rgba(255,77,79,0.2); border-radius: 12rpx; font-size: 24rpx; }

.action-bar { display: flex; padding: 24rpx 32rpx; gap: 16rpx; }
.action-btn { flex: 1; padding: 20rpx 0; text-align: center; border-radius: 12rpx; font-size: 28rpx; }
.action-btn.edit { background: #fff; color: #1BA0D7; border: 1rpx solid #1BA0D7; }
.action-btn.advance { background: #1BA0D7; color: #fff; }
.action-btn.lost { background: #fff; color: #FF4D4F; border: 1rpx solid #FF4D4F; }
.action-btn:active { opacity: 0.85; }

.section { margin-top: 16rpx; }
.section-title { font-size: 26rpx; color: #8C8C8C; padding: 0 32rpx 12rpx; }
.title-count { color: #BFBFBF; }
.info-card { background: #fff; margin: 0 24rpx; border-radius: 16rpx; padding: 8rpx 24rpx; }

.info-row { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid #F0F2F5; align-items: flex-start; }
.info-row:last-child { border-bottom: none; }
.info-label { width: 160rpx; font-size: 28rpx; color: #8C8C8C; flex-shrink: 0; }
.info-value { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.info-value.placeholder { color: #BFBFBF; }
.chip {
  display: inline-block; padding: 6rpx 16rpx; margin: 0 12rpx 12rpx 0;
  background: #E6F4FB; color: #1BA0D7;
  border-radius: 16rpx; font-size: 22rpx;
}
.wish-item { display: inline-block; margin-right: 16rpx; margin-bottom: 8rpx; color: #1BA0D7; font-size: 26rpx; }
.wish-item::after { content: "、"; color: #BFBFBF; }
.wish-item:last-child::after { content: ""; }

.trip-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F2F5; }
.trip-item:last-child { border-bottom: none; }
.trip-item:active { opacity: 0.6; }
.trip-title { font-size: 28rpx; color: #1A1A1A; }
.trip-status { font-size: 24rpx; color: #1BA0D7; }
.title-action { float: right; font-size: 24rpx; color: #1BA0D7; font-weight: normal; }

.quote-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F2F5; }
.quote-item:last-child { border-bottom: none; }
.quote-item:active { opacity: 0.6; }
.quote-left { display: flex; align-items: center; }
.quote-ver { font-size: 22rpx; color: #1BA0D7; background: #1BA0D714; padding: 4rpx 12rpx; border-radius: 6rpx; margin-right: 16rpx; }
.quote-amount { font-size: 30rpx; color: #1A1A1A; font-weight: 500; }
.quote-right { display: flex; flex-direction: column; align-items: flex-end; }
.quote-status { font-size: 24rpx; color: #FF9F2C; }
.quote-time { font-size: 22rpx; color: #BFBFBF; margin-top: 4rpx; }

.note-item { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid #F0F2F5; }
.note-item:last-child { border-bottom: none; }
.note-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #1BA0D7; margin-top: 12rpx; margin-right: 16rpx; flex-shrink: 0; }
.note-body { flex: 1; }
.note-time { font-size: 22rpx; color: #BFBFBF; margin-bottom: 8rpx; }
.note-content { font-size: 28rpx; color: #1A1A1A; line-height: 1.6; }

.empty-tip { padding: 24rpx 0; text-align: center; font-size: 24rpx; color: #BFBFBF; }

.footer-input { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); }
.note-input { flex: 1; padding: 18rpx 24rpx; background: #F5F7FA; border-radius: 32rpx; font-size: 28rpx; }
.send-btn { padding: 0 32rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 28rpx; display: flex; align-items: center; }
.send-btn.disabled { background: #C7DDF0; color: #fff; }

<!-- pages/order/list/list.wxml -->
<view class="page">

  <scroll-view scroll-x class="status-tabs" enhanced show-scrollbar="{{false}}">
    <view class="status-tab {{currentStatus===item.key?'active':''}}"
          wx:for="{{statusTabs}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onStatusTap"
          style="{{currentStatus===item.key ? 'color:#fff;background:'+item.color+';border-color:'+item.color : 'color:'+item.color}}">
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <view class="list-area">
    <view class="state-box" wx:if="{{pageState==='loading'}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-line sk-title"></view>
        <view class="sk-line sk-sub"></view>
      </view>
    </view>

    <view class="state-box" wx:elif="{{pageState==='empty'}}">
      <view class="empty-illu">¥</view>
      <view class="empty-text">暂无订单</view>
      <view class="empty-tip">点击右下角"+"新建订单</view>
    </view>

    <view class="state-box" wx:elif="{{pageState==='error'}}">
      <view class="err-illu">!</view>
      <view class="err-text">网络异常，加载失败</view>
      <view class="err-retry" bindtap="onRetry">点击重试</view>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{orderList}}" wx:key="_id"
            data-id="{{item._id}}" bindtap="onOrderTap">
        <view class="order-head">
          <view class="status-tag" style="color:{{item.statusColor}};background:{{item.statusColor}}1A;">
            {{item.statusLabel}}
          </view>
        </view>
        <view class="order-body">
          <text class="total-label">订单总额</text>
          <text class="total-amount">¥{{item.totalText}}</text>
        </view>
        <view class="badge-group">
          <view class="badge {{item.depositPaid?'badge-done':'badge-todo'}}">
            <text class="badge-icon">{{item.depositPaid?'✓':'·'}}</text>定金
          </view>
          <view class="badge {{item.contractStatus==='signed'?'badge-done':'badge-todo'}}">
            <text class="badge-icon">{{item.contractStatus==='signed'?'✓':'·'}}</text>合同
          </view>
          <view class="badge {{item.balancePaid?'badge-done':'badge-todo'}}">
            <text class="badge-icon">{{item.balancePaid?'✓':'·'}}</text>尾款
          </view>
          <view class="badge badge-info">预订 {{item.bookingProgress}}</view>
          <view class="badge {{item.docSent?'badge-done':'badge-todo'}}">
            <text class="badge-icon">{{item.docSent?'✓':'·'}}</text>资料
          </view>
        </view>
        <view class="order-meta">
          <text class="meta-time">更新于 {{item.updatedAtText}}</text>
        </view>
      </view>

      <view class="load-more" wx:if="{{loadingMore}}">加载中...</view>
      <view class="load-more" wx:elif="{{!hasMore && orderList.length}}">没有更多了</view>
    </view>
  </view>

  <view class="fab" bindtap="onCreateTap">+</view>
  <view class="safe-bottom"></view>
</view>
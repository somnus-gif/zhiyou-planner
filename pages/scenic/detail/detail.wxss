/* pages/scenic/detail/detail.wxss - 景点详情（图片管理版） */
.page { min-height: 100vh; padding-bottom: 40rpx; background: #F2F5F8; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.loading-text { color: #8C8C8C; font-size: 28rpx; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx; }
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

/* 顶部大图 */
.gallery { width: 100%; height: 480rpx; background: linear-gradient(135deg, #1BA0D7, #1781AC); position: relative; }
.swiper { width: 100%; height: 100%; }
.swiper-img { width: 100%; height: 100%; }
.swiper-initial { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 200rpx; font-weight: 600; }
.img-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

/* 图片管理区 */
.image-manage-section {
  background: #fff;
  margin: -20rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  padding: 0;
}
.manage-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.manage-btn {
  font-size: 24rpx;
  color: #595959;
  padding: 8rpx 20rpx;
  background: #F2F5F8;
  border-radius: 20rpx;
}
.manage-btn.primary {
  background: linear-gradient(135deg, #0F7BA6, #1BA0D7);
  color: #fff;
  font-weight: 500;
}
.manage-btn:active { opacity: 0.8; }

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.img-item {
  position: relative;
  width: calc((100% - 36rpx) / 4);
  padding-top: calc((100% - 36rpx) / 4);
  border-radius: 12rpx;
  overflow: hidden;
  background: #F2F5F8;
}
.img-thumb {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.img-cover-tag {
  position: absolute;
  top: 0; left: 0;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #FF9F2C, #FA8C16);
  color: #fff;
  font-size: 20rpx;
  border-bottom-right-radius: 12rpx;
  font-weight: 500;
}
.img-add-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F2F5F8;
  border: 2rpx dashed #D9E0E8;
  border-radius: 12rpx;
}
.img-add-item:active { opacity: 0.7; }
.img-add-item .add-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%);
  font-size: 48rpx;
  color: #1BA0D7;
  font-weight: 300;
}
.img-add-item .add-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 30%);
  font-size: 20rpx;
  color: #8C8C8C;
}

/* 编辑模式遮罩 */
.img-edit-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 5;
}
.img-edit-btn {
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.95);
  color: #1A1A1A;
  font-size: 20rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}
.img-edit-btn.set-cover-btn {
  background: linear-gradient(135deg, #0F7BA6, #1BA0D7);
  color: #fff;
}
.img-edit-btn.delete-btn {
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  color: #fff;
}
.img-edit-btn:active { opacity: 0.8; }

/* 基本信息 */
.header { background: #fff; padding: 32rpx 32rpx 24rpx; margin-top: 24rpx; }
.title { font-size: 40rpx; color: #1A1A1A; font-weight: 600; }
.loc-row { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; }
.loc { font-size: 24rpx; color: #8C8C8C; margin-right: 16rpx; }
.tag { font-size: 22rpx; color: #1BA0D7; margin-right: 12rpx; }

.info-grid { background: #fff; margin: 16rpx 24rpx 0; border-radius: 16rpx; padding: 8rpx 24rpx; display: flex; flex-wrap: wrap; }
.info-cell { width: 50%; padding: 20rpx 0; box-sizing: border-box; }
.info-cell:nth-child(odd) { padding-right: 16rpx; }
.cell-label { font-size: 22rpx; color: #8C8C8C; }
.cell-value { font-size: 28rpx; color: #1A1A1A; margin-top: 6rpx; }
.price-text { color: #FF9F2C; font-weight: 600; }

.section { margin-top: 24rpx; }
.section .section-title {
  font-size: 26rpx;
  color: #8C8C8C;
  padding: 0 32rpx 12rpx;
  font-weight: normal;
}
.chip-list { padding: 0 24rpx; display: flex; flex-wrap: wrap; }
.chip { padding: 10rpx 24rpx; margin: 0 16rpx 16rpx 0; border-radius: 24rpx; font-size: 24rpx; }
.chip.highlight { background: #E6F4FB; color: #1BA0D7; }
.chip.suitable { background: #FFF7E6; color: #FA8C16; }

.intro-card { background: #fff; margin: 0 24rpx; border-radius: 16rpx; padding: 24rpx; }
.intro-text { font-size: 28rpx; color: #1A1A1A; line-height: 1.7; white-space: pre-wrap; }

/* 视频区 */
.video-section { margin-top: 24rpx; padding: 0 24rpx; }
.video-section .section-title { padding: 0 0 12rpx; }
.scenic-video { width: 100%; height: 400rpx; border-radius: 16rpx; background: #000; }
.upload-video-btn { margin: 16rpx 24rpx 0; padding: 20rpx 0; text-align: center; background: #fff; color: #1BA0D7; border-radius: 12rpx; font-size: 26rpx; border: 2rpx dashed #1BA0D7; }

/* 游玩方式 */
.section .section-title-row {
  padding: 0 32rpx 12rpx;
}
.section .section-title-row .section-title {
  padding: 0;
  font-size: 26rpx;
  color: #8C8C8C;
  font-weight: normal;
}
.edit-link { font-size: 24rpx; color: #1BA0D7; }
.add-guide-btn { margin: 24rpx; padding: 20rpx; text-align: center; border: 2rpx dashed #1BA0D7; color: #1BA0D7; border-radius: 12rpx; font-size: 26rpx; }

.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); }
.action-btn { flex: 1; padding: 22rpx 0; text-align: center; border-radius: 12rpx; font-size: 30rpx; border: none; }
.action-btn.ghost { background: #fff; color: #1BA0D7; border: 1rpx solid #1BA0D7; }
.action-btn.primary { background: #1BA0D7; color: #fff; }
.action-btn::after { border: none; }
.action-btn:active { opacity: 0.85; }

.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 99; display: flex; align-items: flex-end; }
.guide-sheet { width: 100%; background: #FFFFFF; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1F1F1F; margin-bottom: 24rpx; }
.sheet-textarea { width: 100%; height: 44vh; min-height: 360rpx; font-size: 30rpx; line-height: 1.6; color: #1F1F1F; background: #F5F7FA; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; }
.sheet-actions { display: flex; margin-top: 28rpx; }
.sheet-btn { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx; font-size: 30rpx; }
.sheet-btn.ghost { margin-right: 20rpx; color: #5A6472; background: #F5F7FA; }
.sheet-btn.primary { color: #FFFFFF; background: #1BA0D7; }
.sheet-btn:active { opacity: 0.85; }
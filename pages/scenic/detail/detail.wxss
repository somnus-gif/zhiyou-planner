/* pages/scenic/detail/detail.wxss */
.page { min-height: 100vh; padding-bottom: 40rpx; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.loading-text { color: #8C8C8C; font-size: 28rpx; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx; }
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

.gallery { width: 100%; height: 480rpx; background: linear-gradient(135deg, #1BA0D7, #1781AC); position: relative; }
.swiper { width: 100%; height: 100%; }
.swiper-img { width: 100%; height: 100%; }
.swiper-initial { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 200rpx; font-weight: 600; }
.upload-cover-btn { position: absolute; right: 24rpx; bottom: 24rpx; padding: 12rpx 28rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 24rpx; border-radius: 28rpx; }

.header { background: #fff; padding: 32rpx 32rpx 24rpx; }
.title { font-size: 40rpx; color: #1A1A1A; font-weight: 600; }
.loc-row { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; }
.loc { font-size: 24rpx; color: #8C8C8C; margin-right: 16rpx; }
.tag { font-size: 22rpx; color: #1BA0D7; margin-right: 12rpx; }

.info-grid { background: #fff; margin: 16rpx 24rpx 0; border-radius: 16rpx; padding: 8rpx 24rpx; display: flex; flex-wrap: wrap; }
.info-cell { width: 50%; padding: 20rpx 0; box-sizing: border-box; }
.info-cell:nth-child(odd) { padding-right: 16rpx; }
.cell-label { font-size: 22rpx; color: #8C8C8C; }
.cell-value { font-size: 28rpx; color: #1A1A1A; margin-top: 6rpx; }
.price-text { color: #FF9F2C; font-weight: 600; }

.section { margin-top: 24rpx; }
.section-title { font-size: 26rpx; color: #8C8C8C; padding: 0 32rpx 12rpx; }
.chip-list { padding: 0 24rpx; display: flex; flex-wrap: wrap; }
.chip { padding: 10rpx 24rpx; margin: 0 16rpx 16rpx 0; border-radius: 24rpx; font-size: 24rpx; }
.chip.highlight { background: #E6F4FB; color: #1BA0D7; }
.chip.suitable { background: #FFF7E6; color: #FA8C16; }

.intro-card { background: #fff; margin: 0 24rpx; border-radius: 16rpx; padding: 24rpx; }
.intro-text { font-size: 28rpx; color: #1A1A1A; line-height: 1.7; white-space: pre-wrap; }

/* 视频区 */
.video-section { margin-top: 24rpx; padding: 0 24rpx; }
.video-section .section-title { padding: 0 0 12rpx; }
.scenic-video { width: 100%; height: 400rpx; border-radius: 16rpx; background: #000; }
.upload-video-btn { margin: 16rpx 24rpx 0; padding: 16rpx 0; text-align: center; background: #E6F4FB; color: #1BA0D7; border-radius: 12rpx; font-size: 26rpx; }

/* 游玩方式 */
.section-title-row { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx 12rpx; }
.section-title-row .section-title { padding: 0; }
.edit-link { font-size: 24rpx; color: #1BA0D7; }
.add-guide-btn { margin: 24rpx; padding: 20rpx; text-align: center; border: 2rpx dashed #1BA0D7; color: #1BA0D7; border-radius: 12rpx; font-size: 26rpx; }

.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); }
.action-btn { flex: 1; padding: 22rpx 0; text-align: center; border-radius: 12rpx; font-size: 30rpx; border: none; }
.action-btn.ghost { background: #fff; color: #1BA0D7; border: 1rpx solid #1BA0D7; }
.action-btn.primary { background: #1BA0D7; color: #fff; }
.action-btn::after { border: none; }
.action-btn:active { opacity: 0.85; }

/* pages/quote/detail/detail.wxss */
.page { min-height: 100vh; padding-bottom: 200rpx; background: #F5F7FA; }

.hero-card { background: linear-gradient(135deg, #1BA0D7, #1781AC); margin: 16rpx 32rpx; padding: 28rpx 24rpx; border-radius: 16rpx; box-shadow: 0 4rpx 16rpx rgba(27,160,215,0.18); }
.hero-row { display: flex; align-items: center; padding-bottom: 16rpx; border-bottom: 1rpx solid rgba(255,255,255,0.2); }
.hero-label { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.hero-version { font-size: 32rpx; color: #fff; font-weight: 600; margin-left: 12rpx; }
.status-tag { margin-left: auto; padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; background: #fff; }
.hero-summary { display: flex; padding: 20rpx 0; }
.hero-cell { flex: 1; }
.cell-label { font-size: 22rpx; color: rgba(255,255,255,0.85); margin-bottom: 6rpx; }
.cell-value { font-size: 32rpx; color: #fff; font-weight: 600; }
.cell-value.profit { color: #FFE082; }
.hero-meta { font-size: 22rpx; color: rgba(255,255,255,0.85); }

.section { background: #fff; margin: 16rpx 32rpx; padding: 24rpx; border-radius: 16rpx; }
.section-title { font-size: 28rpx; color: #1A1A1A; font-weight: 600; margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #F0F2F5; }

.item-row { padding: 16rpx 0; border-bottom: 1rpx solid #F5F7FA; }
.item-row:last-child { border-bottom: 0; }
.item-line1 { display: flex; align-items: center; margin-bottom: 8rpx; }
.item-type { padding: 4rpx 12rpx; border-radius: 6rpx; font-size: 22rpx; flex-shrink: 0; }
.item-name { flex: 1; font-size: 28rpx; color: #1A1A1A; margin-left: 12rpx; }
.item-sub { font-size: 28rpx; color: #1BA0D7; font-weight: 500; }
.item-line2 { display: flex; flex-direction: column; padding-left: 8rpx; }
.item-spec { font-size: 24rpx; color: #595959; margin-bottom: 4rpx; }
.item-detail { font-size: 22rpx; color: #8C8C8C; }
.empty-tip { text-align: center; color: #BFBFBF; font-size: 24rpx; padding: 24rpx 0; }

.timeline { padding: 8rpx 0; }
.tl-item { display: flex; padding: 12rpx 0; position: relative; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #FF9F2C; flex-shrink: 0; margin-top: 8rpx; margin-right: 16rpx; }
.tl-item:not(:last-child)::before { content: ''; position: absolute; left: 7rpx; top: 28rpx; bottom: -12rpx; width: 2rpx; background: #F0F2F5; }
.tl-content { flex: 1; }
.tl-line1 { display: flex; justify-content: space-between; align-items: center; }
.tl-version { font-size: 26rpx; color: #FF9F2C; font-weight: 600; }
.tl-total { font-size: 26rpx; color: #1A1A1A; font-weight: 500; }
.tl-reason { font-size: 26rpx; color: #595959; margin: 4rpx 0; }
.tl-time { font-size: 22rpx; color: #BFBFBF; }

.actions { margin: 16rpx 32rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.act-btn { flex: 1 1 40%; border-radius: 40rpx; font-size: 28rpx; padding: 16rpx 0; line-height: 1.4; }
.act-btn.edit { background: #1BA0D7; color: #fff; }
.act-btn.send { background: #fff; color: #1BA0D7; border: 1rpx solid #1BA0D7; }
.act-btn.confirm { background: #07C160; color: #fff; }
.act-btn.order { background: #1BA0D7; color: #fff; }
.act-btn.archive { background: #fff; color: #8C8C8C; border: 1rpx solid #D9D9D9; }

.safe-bottom { height: 60rpx; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-text { color: #8C8C8C; font-size: 28rpx; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx; }
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

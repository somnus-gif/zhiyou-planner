/* pages/trip/editor/editor.wxss */
.page { min-height: 100vh; background: #F5F7FA; padding-bottom: 40rpx; }

.state-box { padding: 120rpx 40rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: #999; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFE1E1; color: #F5222D; margin: 0 auto 24rpx; font-size: 56rpx; line-height: 96rpx; }
.err-text { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.err-retry { display: inline-block; padding: 16rpx 48rpx; background: #1BA0D7; color: #fff; border-radius: 40rpx; font-size: 26rpx; }

/* 标题区 */
.title-card { background: #fff; padding: 32rpx 24rpx; margin-bottom: 16rpx; }
.title-row { display: flex; align-items: center; }
.title-input { flex: 1; font-size: 36rpx; color: #1A1A1A; font-weight: 600; }
.sub-row { margin-top: 16rpx; font-size: 26rpx; }
.sub-label { color: #999; }
.sub-value { color: #1BA0D7; margin-left: 12rpx; }

/* 按天 */
.day-card { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.day-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.day-label { font-size: 30rpx; font-weight: 600; color: #1BA0D7; margin-right: 20rpx; }
.day-city-input { flex: 1; }
.city-input { font-size: 26rpx; color: #666; }
.day-del { font-size: 24rpx; color: #F5222D; padding: 8rpx 16rpx; }

.items-box { margin-bottom: 16rpx; }
.item-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #F5F7FA; }
.item-row:last-child { border-bottom: none; }
.item-type-tag { width: 80rpx; text-align: center; padding: 6rpx 0; font-size: 22rpx; border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; }
.type-scenic { background: #E6F4FF; color: #1BA0D7; }
.type-transport { background: #FFF7E6; color: #FA8C16; }
.type-meal { background: #FFF1F0; color: #F5222D; }
.type-hotel { background: #F6FFED; color: #52C41A; }
.type-custom { background: #F0F2F5; color: #666; }

.item-main { flex: 1; }
.item-name { font-size: 28rpx; color: #1A1A1A; margin-bottom: 6rpx; }
.item-name-input { font-size: 28rpx; color: #1A1A1A; margin-bottom: 6rpx; }
.item-note-input { font-size: 24rpx; color: #999; }

.hotel-link-row { display: flex; align-items: center; gap: 12rpx; }
.hotel-link-row .item-name-input { flex: 1; margin-bottom: 0; }
.link-hotel-btn { font-size: 22rpx; color: #1BA0D7; background: #E6F4FB; padding: 8rpx 16rpx; border-radius: 8rpx; white-space: nowrap; }
.link-hotel-btn.linked { color: #52C41A; background: #F6FFED; }

.item-actions { display: flex; gap: 8rpx; }
.move-btn { width: 48rpx; height: 48rpx; text-align: center; line-height: 48rpx; font-size: 24rpx; color: #666; border-radius: 8rpx; background: #F5F7FA; }
.move-btn.del { color: #F5222D; }

.empty-items { font-size: 24rpx; color: #BFBFBF; padding: 32rpx 0; text-align: center; }

.add-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.add-btn { padding: 12rpx 20rpx; background: #F5F7FA; color: #666; font-size: 24rpx; border-radius: 24rpx; }
.add-btn.primary { background: #E6F4FF; color: #1BA0D7; }

.add-day-btn { margin: 24rpx; padding: 24rpx; background: #fff; border: 2rpx dashed #1BA0D7; border-radius: 16rpx; color: #1BA0D7; text-align: center; font-size: 28rpx; }

/* 底部保存栏 */
.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
.footer-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 12rpx; font-size: 30rpx; }
.footer-btn.preview { background: #F5F7FA; color: #1BA0D7; }
.footer-btn.save { background: #1BA0D7; color: #fff; }
.footer-btn.save.disabled { background: #C7DDF0; }

/* 景点选择弹窗 */
.picker-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 10; }
.picker-panel { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 11; max-height: 80vh; display: flex; flex-direction: column; }
.picker-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #F0F2F5; }
.picker-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.picker-close { font-size: 40rpx; color: #999; padding: 0 8rpx; }
.picker-search { display: flex; gap: 12rpx; padding: 20rpx 24rpx; }
.picker-search-input { flex: 1; padding: 16rpx 24rpx; background: #F5F7FA; border-radius: 32rpx; font-size: 28rpx; }
.picker-search-btn { padding: 0 28rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; display: flex; align-items: center; }
.picker-list { flex: 1; max-height: 60vh; }
.picker-item { padding: 24rpx; border-bottom: 1rpx solid #F5F7FA; }
.picker-item-name { font-size: 28rpx; color: #1A1A1A; }
.picker-item-meta { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.picker-empty { padding: 80rpx 24rpx; text-align: center; color: #BFBFBF; font-size: 26rpx; }

/* ===== 行程亮点 / 接机服务表单 ===== */
.form-card { background: #fff; padding: 28rpx 24rpx; margin-bottom: 16rpx; }
.form-title { font-size: 30rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 20rpx; }
.form-sub { font-size: 22rpx; color: #BFBFBF; font-weight: 400; margin-left: 12rpx; }
.form-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #F5F7FA; }
.form-row:last-child { border-bottom: none; }
.form-row-top { align-items: flex-start; }
.form-label { width: 132rpx; flex-shrink: 0; font-size: 26rpx; color: #8C8C8C; }
.form-input { flex: 1; font-size: 27rpx; color: #1A1A1A; padding: 10rpx 0; }
.form-textarea { width: 100%; min-height: 140rpx; font-size: 27rpx; color: #1A1A1A; padding: 10rpx 0; box-sizing: border-box; }
.form-textarea-sm { flex: 1; min-height: 100rpx; padding-top: 10rpx; }

/* pages/hotel/list/list.wxss */
.page { min-height: 100vh; background: #F5F7FA; }

.state-box { padding: 120rpx 40rpx; text-align: center; }
.skeleton-card { background: #fff; margin: 24rpx; border-radius: 16rpx; padding: 32rpx; }
.sk-line { height: 32rpx; background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: sk 1.2s infinite; border-radius: 8rpx; margin-bottom: 16rpx; }
.sk-title { width: 50%; }
.sk-sub { width: 80%; }
@keyframes sk { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.empty-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #F0F5FF; color: #1BA0D7; margin: 0 auto 24rpx; font-size: 40rpx; line-height: 96rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.empty-tip { font-size: 24rpx; color: #999; }

.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF1F0; color: #FF4D4F; margin: 0 auto 24rpx; font-size: 56rpx; line-height: 96rpx; }
.err-text { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.err-retry { display: inline-block; padding: 16rpx 48rpx; background: #1BA0D7; color: #fff; border-radius: 40rpx; font-size: 26rpx; }

.hotel-list { padding: 16rpx 0; }
.hotel-item { background: #fff; margin: 0 24rpx 24rpx; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.hotel-item:active { opacity: 0.85; }
.item-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.city-text { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.date-text { font-size: 24rpx; color: #999; }

.item-body { display: flex; align-items: center; }
.hotel-thumb { width: 160rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; background: #f5f5f5; }
.hotel-info { flex: 1; }
.selected-hotel-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; display: block; }
.star-row { margin-top: 8rpx; display: flex; align-items: center; gap: 12rpx; }
.star-tag { font-size: 20rpx; color: #fff; background: #FA8C16; padding: 2rpx 12rpx; border-radius: 6rpx; }
.room-type { font-size: 22rpx; color: #666; }
.selected-price { font-size: 28rpx; color: #FF9F2C; font-weight: 600; margin-top: 8rpx; display: block; }

.item-body.unselected { padding: 16rpx 0; }
.opt-count { font-size: 26rpx; color: #999; }

.item-meta { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; font-size: 22rpx; color: #BFBFBF; }

.load-more { text-align: center; padding: 24rpx; color: #999; font-size: 24rpx; }

.fab { position: fixed; right: 32rpx; bottom: 120rpx; width: 112rpx; height: 112rpx; border-radius: 50%; background: #1BA0D7; color: #fff; font-size: 56rpx; text-align: center; line-height: 112rpx; box-shadow: 0 8rpx 24rpx rgba(27,160,215,0.4); z-index: 10; }
.fab:active { transform: scale(0.95); }

.safe-bottom { height: env(safe-area-inset-bottom); }

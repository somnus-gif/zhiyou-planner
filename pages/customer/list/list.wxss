/* pages/customer/list/list.wxss */
.page { min-height: 100vh; padding-bottom: 120rpx; }

.search-bar { background: #fff; padding: 16rpx 24rpx; position: sticky; top: 0; z-index: 10; }
.search-input { display: flex; align-items: center; background: #F5F7FA; border-radius: 32rpx; padding: 12rpx 24rpx; }
.search-icon { color: #8C8C8C; font-size: 26rpx; margin-right: 12rpx; font-weight: 700; }
.search-field { flex: 1; font-size: 28rpx; }
.search-clear { color: #BFBFBF; font-size: 32rpx; padding: 0 8rpx; }

.stage-tabs { white-space: nowrap; padding: 16rpx 24rpx 8rpx; background: #fff; }
.stage-tab {
  display: inline-flex; align-items: center;
  padding: 10rpx 24rpx; margin-right: 16rpx;
  border: 1rpx solid currentColor;
  border-radius: 32rpx; font-size: 26rpx; background: #fff;
}
.stage-tab.active { color: #fff; }
.stage-count { margin-left: 8rpx; font-size: 22rpx; min-width: 28rpx; text-align: center; }

.list-area { padding-top: 8rpx; }
.state-box { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }

.skeleton-card { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; }
.sk-line { height: 32rpx; background: #F0F2F5; border-radius: 8rpx; }
.sk-title { width: 40%; margin-bottom: 16rpx; }
.sk-sub { width: 70%; }

.empty-illu {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 4rpx dashed #BFBFBF; color: #BFBFBF;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; margin-bottom: 24rpx;
}
.empty-text { font-size: 30rpx; color: #595959; }
.empty-tip { font-size: 24rpx; color: #8C8C8C; margin-top: 8rpx; }

.err-illu {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #FFF1F0; color: #FF4D4F;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700; margin-bottom: 24rpx;
}
.err-text { font-size: 30rpx; color: #595959; }
.err-retry { margin-top: 16rpx; padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 32rpx; font-size: 26rpx; }

.cust-card { background: #fff; border-radius: 16rpx; margin: 16rpx 32rpx; padding: 28rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(27,160,215,0.06); }
.cust-card:active { background: #F5F7FA; }
.cust-head { display: flex; align-items: center; }
.cust-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg, #1BA0D7, #1781AC);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.cust-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.cust-name { font-size: 30rpx; color: #1A1A1A; font-weight: 500; }
.cust-phone { font-size: 24rpx; color: #8C8C8C; margin-top: 4rpx; }
.stage-tag { padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; flex-shrink: 0; }

.cust-meta { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #F0F2F5; font-size: 24rpx; }
.meta-wish { margin-bottom: 8rpx; }
.meta-label { color: #8C8C8C; }
.meta-text { color: #595959; }
.meta-time { color: #BFBFBF; font-size: 22rpx; }

.load-more { text-align: center; color: #BFBFBF; font-size: 24rpx; padding: 24rpx 0; }

.fab {
  position: fixed; right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, #1BA0D7, #1781AC);
  color: #fff; font-size: 56rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(27,160,215,0.4);
  z-index: 100;
}
.fab:active { transform: scale(0.92); }

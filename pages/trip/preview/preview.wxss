/* pages/trip/preview/preview.wxss */
.page { min-height: 100vh; background: #F5F7FA; padding-bottom: 40rpx; }

.state-box { padding: 120rpx 40rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: #999; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFE1E1; color: #F5222D; margin: 0 auto 24rpx; font-size: 56rpx; line-height: 96rpx; }
.err-text { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.err-retry { display: inline-block; padding: 16rpx 48rpx; background: #1BA0D7; color: #fff; border-radius: 40rpx; font-size: 26rpx; }

/* 头部 */
.hero { background: linear-gradient(135deg, #1BA0D7 0%, #1BA0D7CC 100%); padding: 40rpx 32rpx; color: #fff; }
.hero-title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.hero-meta { display: flex; align-items: center; font-size: 26rpx; margin-top: 8rpx; }
.meta-label { opacity: 0.8; margin-right: 16rpx; }
.meta-value { font-size: 26rpx; }
.status-tag { background: rgba(255,255,255,0.25); padding: 4rpx 16rpx; border-radius: 12rpx; }

/* 服务说明 */
.section-block { background: #fff; margin: 24rpx; border-radius: 16rpx; padding: 24rpx; }
.section-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.section-bar { width: 6rpx; height: 32rpx; background: #1BA0D7; border-radius: 4rpx; margin-right: 16rpx; }
.section-title-text { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.service-grid { display: flex; flex-wrap: wrap; }
.service-item { width: 50%; display: flex; align-items: flex-start; padding: 12rpx 0; box-sizing: border-box; }
.service-icon { width: 64rpx; height: 64rpx; border-radius: 50%; background: #E6F4FB; color: #1BA0D7; font-size: 28rpx; text-align: center; line-height: 64rpx; margin-right: 16rpx; flex-shrink: 0; }
.service-icon-hotel { background: #F6FFED; color: #52C41A; }
.service-icon-meal { background: #FFF1F0; color: #F5222D; }
.service-icon-car { background: #FFF7E6; color: #FA8C16; }
.service-icon-guide { background: #F9F0FF; color: #722ED1; }
.service-icon-insurance { background: #FFFBE6; color: #D4B106; }
.service-text { flex: 1; }
.service-title { font-size: 26rpx; font-weight: 600; color: #1A1A1A; }
.service-desc { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* 按天卡片 */
.day-card { background: #fff; margin: 24rpx; border-radius: 16rpx; padding: 32rpx 24rpx; }
.day-header { display: flex; align-items: center; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid #1BA0D7; }
.day-badge { width: 56rpx; height: 56rpx; border-radius: 50%; background: #1BA0D7; color: #fff; text-align: center; line-height: 56rpx; font-size: 28rpx; font-weight: 600; margin-right: 20rpx; }
.day-info { flex: 1; }
.day-label { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.day-city { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.item-list { }
.item-card { padding: 16rpx 0; border-bottom: 1rpx solid #F5F7FA; }
.item-card:last-child { border-bottom: none; }
.item-card.has-image { padding: 0; margin: 16rpx 0; border-radius: 12rpx; overflow: hidden; background: #FAFCFE; border: 1rpx solid #E6F4FF; }

/* 景点封面 */
.scenic-cover { position: relative; width: 100%; }
.item-image { width: 100%; height: 360rpx; display: block; }
.scenic-tag { position: absolute; top: 16rpx; left: 16rpx; padding: 6rpx 16rpx; background: rgba(27,160,215,0.85); color: #fff; font-size: 20rpx; border-radius: 6rpx; }

.item-body { padding: 16rpx; }
.item-type { display: inline-block; padding: 4rpx 16rpx; font-size: 22rpx; border-radius: 6rpx; margin-bottom: 8rpx; }
.type-scenic { background: #E6F4FF; color: #1BA0D7; }
.type-transport { background: #FFF7E6; color: #FA8C16; }
.type-meal { background: #FFF1F0; color: #F5222D; }
.type-hotel { background: #F6FFED; color: #52C41A; }
.type-custom { background: #F0F2F5; color: #666; }

.item-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.item-note { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.item-intro { font-size: 24rpx; color: #888; margin-top: 8rpx; line-height: 1.6; }
.item-highlights { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.highlight-tag { font-size: 20rpx; color: #1BA0D7; background: #E6F4FF; padding: 4rpx 12rpx; border-radius: 6rpx; }

/* 游玩方式 */
.play-guide { margin-top: 16rpx; padding: 16rpx; background: #FFF7E6; border-radius: 8rpx; border-left: 4rpx solid #FA8C16; }
.guide-label { font-size: 22rpx; color: #FA8C16; font-weight: 600; margin-bottom: 6rpx; }
.guide-text { font-size: 24rpx; color: #595959; line-height: 1.6; }

/* 景点视频 */
.scenic-video { width: 100%; height: 360rpx; border-radius: 12rpx; margin-top: 16rpx; background: #000; }

/* 图片画廊 */
.image-gallery { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.gallery-thumb { width: 160rpx; height: 120rpx; border-radius: 8rpx; background: #f5f5f5; }

/* 酒店卡片 */
.hotel-item-card { display: flex; padding: 0; border-radius: 12rpx; overflow: hidden; background: #F6FFED; border: 1rpx solid #D9F7BE; }
.hotel-item-card.clickable { }
.hotel-item-card.clickable:active { opacity: 0.85; }
.hotel-cover { width: 200rpx; height: 200rpx; flex-shrink: 0; background: #f5f5f5; }
.hotel-body { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: center; }
.hotel-name-row { display: flex; align-items: center; justify-content: space-between; }
.star-dots { display: flex; }
.star-dot { font-size: 24rpx; color: #FA8C16; }
.hotel-price { font-size: 28rpx; color: #FF9F2C; font-weight: 600; margin-top: 8rpx; }
.hotel-jump-tip { font-size: 22rpx; color: #52C41A; margin-top: 8rpx; }

.empty-items { padding: 24rpx 0; text-align: center; color: #BFBFBF; font-size: 24rpx; }

.extra-row { display: flex; padding: 12rpx 0; font-size: 26rpx; }
.extra-label { color: #999; width: 80rpx; }
.extra-value { color: #333; flex: 1; }

/* 底部栏 */
.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 12rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
.footer-btn { flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; }
.footer-btn.edit { background: #F5F7FA; color: #1BA0D7; }
.footer-btn.copy { background: #E6F4FF; color: #1BA0D7; }
.footer-btn.qr { background: #F9F0FF; color: #722ED1; }
.footer-btn.reset { background: #FFF7E6; color: #FA8C16; }
.footer-btn.share { background: #1BA0D7; color: #fff; padding: 0; margin: 0; border: none; line-height: 88rpx; }
.footer-btn.share::after { border: none; }

/* 二维码弹窗 */
.qr-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 100; display: flex; align-items: center; justify-content: center; }
.qr-modal { width: 560rpx; background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; text-align: center; }
.qr-modal-title { font-size: 32rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 24rpx; }
.qr-image { width: 400rpx; height: 400rpx; margin: 0 auto; border: 1rpx solid #f0f0f0; border-radius: 12rpx; }
.qr-modal-tip { font-size: 24rpx; color: #999; margin-top: 16rpx; }
.qr-modal-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.qr-action { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; font-size: 28rpx; }
.qr-action.save { background: #1BA0D7; color: #fff; }
.qr-action.close { background: #F5F7FA; color: #666; }

<!-- pages/trip/editor/editor.wxml -->
<view class="page">

  <view class="state-box" wx:if="{{pageState==='loading'}}">
    <view class="loading-text">加载中...</view>
  </view>

  <view class="state-box" wx:elif="{{pageState==='error'}}">
    <view class="err-illu">!</view>
    <view class="err-text">加载失败</view>
    <view class="err-retry" bindtap="onRetry">点击重试</view>
  </view>

  <block wx:else>
    <!-- 标题区 -->
    <view class="title-card">
      <view class="title-row">
        <input class="title-input" placeholder="行程标题" value="{{title}}" bindinput="onTitleInput" />
      </view>
      <view class="sub-row" wx:if="{{customerName}}">
        <text class="sub-label">客户</text>
        <text class="sub-value">{{customerName}}</text>
      </view>
    </view>

    <!-- 行程亮点 -->
    <view class="form-card">
      <view class="form-title">行程亮点</view>
      <textarea class="form-textarea" placeholder="一句话介绍本次行程的亮点（展示在客户行程页顶部）" value="{{intro}}" bindinput="onIntroInput" />
    </view>

    <!-- 接机服务 -->
    <view class="form-card">
      <view class="form-title">接机服务 <text class="form-sub">选填，展示给客户</text></view>
      <view class="form-row"><text class="form-label">航班号</text><input class="form-input" placeholder="如 AK1571" value="{{pickup.flightNo}}" data-field="flightNo" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">抵达时间</text><input class="form-input" placeholder="如 10:30" value="{{pickup.arriveTime}}" data-field="arriveTime" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">抵达机场</text><input class="form-input" placeholder="如 亚庇国际机场" value="{{pickup.airport}}" data-field="airport" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">集合点</text><input class="form-input" placeholder="如 到达厅 3 号出口" value="{{pickup.meetPoint}}" data-field="meetPoint" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">接送车型</text><input class="form-input" placeholder="如 丰田海狮 11 座" value="{{pickup.vehicle}}" data-field="vehicle" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">司机姓名</text><input class="form-input" placeholder="如 王师傅" value="{{pickup.driverName}}" data-field="driverName" bindinput="onPickupInput" /></view>
      <view class="form-row"><text class="form-label">司机电话</text><input class="form-input" type="number" placeholder="如 13800138000" value="{{pickup.driverPhone}}" data-field="driverPhone" bindinput="onPickupInput" /></view>
      <view class="form-row form-row-top"><text class="form-label">温馨提示</text><textarea class="form-textarea form-textarea-sm" placeholder="如 落地后请开漫游，司机在出口举牌等候" value="{{pickup.note}}" data-field="note" bindinput="onPickupInput" /></view>
    </view>

    <!-- 按天编排 -->
    <view class="day-card" wx:for="{{days}}" wx:for-item="day" wx:for-index="dayIdx" wx:key="dayIdx">
      <view class="day-header">
        <view class="day-label">{{day.dateLabel}}</view>
        <view class="day-city-input">
          <input class="city-input" placeholder="城市" value="{{day.city}}" data-idx="{{dayIdx}}" data-field="city" bindinput="onDayInput" />
        </view>
        <view class="day-del" data-idx="{{dayIdx}}" bindtap="onRemoveDay">删除</view>
      </view>

      <!-- 当天项目 -->
      <view class="items-box">
        <view class="item-row" wx:for="{{day.items}}" wx:for-item="item" wx:for-index="itemIdx" wx:key="itemIdx">
          <view class="item-type-tag type-{{item.type}}">{{item.typeLabel}}</view>
          <view class="item-main">
            <view class="item-name" wx:if="{{item.type==='scenic'}}">{{item.name}}</view>
            <input class="item-name-input" wx:elif="{{item.type!=='hotel'}}" placeholder="{{item.typeLabel}}说明" value="{{item.name}}" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" bindinput="onItemNameInput" />
            <view class="hotel-link-row" wx:else>
              <input class="item-name-input" placeholder="住宿说明" value="{{item.name}}" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" bindinput="onItemNameInput" />
              <view class="link-hotel-btn {{item.refId ? 'linked' : ''}}" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" bindtap="onLinkHotel">{{item.refId ? '已关联' : '关联酒店方案'}}</view>
            </view>
            <input class="item-note-input" placeholder="备注（可选）" value="{{item.note}}" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" bindinput="onItemNoteInput" />
          </view>
          <view class="item-actions">
            <view class="move-btn" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" data-dir="up" bindtap="onMoveItem">↑</view>
            <view class="move-btn" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" data-dir="down" bindtap="onMoveItem">↓</view>
            <view class="move-btn del" data-day-idx="{{dayIdx}}" data-item-idx="{{itemIdx}}" bindtap="onRemoveItem">×</view>
          </view>
        </view>
        <view class="empty-items" wx:if="{{!day.items.length}}">暂无项目，点击下方按钮添加</view>
      </view>

      <!-- 添加项目 -->
      <view class="add-row">
        <view class="add-btn primary" data-day-idx="{{dayIdx}}" bindtap="onOpenScenicPicker">+ 景点</view>
        <view class="add-btn" data-day-idx="{{dayIdx}}" data-type="transport" bindtap="onAddCustomItem">+ 交通</view>
        <view class="add-btn" data-day-idx="{{dayIdx}}" data-type="meal" bindtap="onAddCustomItem">+ 餐食</view>
        <view class="add-btn" data-day-idx="{{dayIdx}}" data-type="hotel" bindtap="onAddCustomItem">+ 住宿</view>
        <view class="add-btn" data-day-idx="{{dayIdx}}" data-type="custom" bindtap="onAddCustomItem">+ 自定义</view>
      </view>
    </view>

    <view class="add-day-btn" bindtap="onAddDay">+ 添加一天</view>

    <view style="height: 180rpx"></view>

    <!-- 底部保存栏 -->
    <view class="footer-bar safe-bottom">
      <view class="footer-btn preview" bindtap="onPreview">预览</view>
      <view class="footer-btn save {{saving ? 'disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保存'}}</view>
    </view>

    <!-- 景点选择弹窗 -->
    <view class="picker-mask" wx:if="{{scenicPickerShow}}" bindtap="onCloseScenicPicker"></view>
    <view class="picker-panel {{scenicPickerShow ? 'show' : ''}}" wx:if="{{scenicPickerShow}}">
      <view class="picker-header">
        <text class="picker-title">选择景点</text>
        <text class="picker-close" bindtap="onCloseScenicPicker">×</text>
      </view>
      <view class="picker-search">
        <input class="picker-search-input" placeholder="搜索景点名称" value="{{scenicKeyword}}" bindinput="onScenicKeywordInput" confirm-type="search" bindconfirm="onSearchScenic" />
        <view class="picker-search-btn" bindtap="onSearchScenic">{{scenicPicking ? '...' : '搜索'}}</view>
      </view>
      <scroll-view scroll-y class="picker-list">
        <view class="picker-item" wx:for="{{scenicOptions}}" wx:key="_id" data-scenic="{{item}}" bindtap="onPickScenic">
          <view class="picker-item-name">{{item.name}}</view>
          <view class="picker-item-meta">{{item.city || '未分类'}}</view>
        </view>
        <view class="picker-empty" wx:if="{{!scenicOptions.length}}">输入关键词搜索景点</view>
      </scroll-view>
    </view>
  </block>
</view>

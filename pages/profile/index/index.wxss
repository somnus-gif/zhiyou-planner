/* pages/profile/index/index.wxss - 我的（占位） */
.page { min-height: 100vh; }

.profile-hero {
  background: linear-gradient(135deg, #1BA0D7 0%, #1781AC 100%);
  padding: 60rpx 32rpx 48rpx;
  display: flex; align-items: center;
  color: #fff;
}
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 600;
}
.info { margin-left: 24rpx; }
.name { font-size: 38rpx; font-weight: 600; }
.role { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.menu {
  margin: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.menu-val { color: #8C8C8C; font-size: 26rpx; }
.menu-tip { padding: 24rpx 0; font-size: 24rpx; color: #BFBFBF; text-align: center; }

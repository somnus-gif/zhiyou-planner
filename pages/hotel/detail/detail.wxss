/* pages/hotel/detail/detail.wxss */
.page { min-height: 100vh; background: #F5F7FA; padding-bottom: 40rpx; }

.state-box { padding: 120rpx 40rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: #999; }
.err-illu { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFE1E1; color: #F5222D; margin: 0 auto 24rpx; font-size: 56rpx; line-height: 96rpx; }
.err-text { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.err-retry { display: inline-block; padding: 16rpx 48rpx; background: #1BA0D7; color: #fff; border-radius: 40rpx; font-size: 26rpx; }

/* 表单 */
.form-card { background: #fff; margin: 24rpx; border-radius: 16rpx; padding: 32rpx 24rpx; }
.form-title { font-size: 32rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 24rpx; }
.form-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #595959; width: 100rpx; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; color: #1A1A1A; border: 1rpx solid #E8E8E8; border-radius: 8rpx; padding: 16rpx 20rpx; }
.form-input.short { width: 160rpx; flex: none; }
.form-picker { flex: 1; font-size: 28rpx; color: #1A1A1A; border: 1rpx solid #E8E8E8; border-radius: 8rpx; padding: 16rpx 20rpx; }
.form-suffix { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.search-btn { width: 100%; height: 88rpx; line-height: 88rpx; background: #1BA0D7; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 16rpx; border: none; }
.search-btn.disabled { opacity: 0.6; }
.search-btn::after { border: none; }

/* 酒店列表 */
.hotel-list { padding: 0 24rpx; }
.list-title { font-size: 26rpx; color: #999; padding: 16rpx 0; }

.hotel-card { background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; border: 2rpx solid transparent; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.hotel-card.selected { border-color: #1BA0D7; box-shadow: 0 4rpx 16rpx rgba(27,160,215,0.15); }
.hotel-cover { width: 100%; height: 320rpx; display: block; background: #f5f5f5; }
.hotel-body { padding: 24rpx; }
.hotel-name-row { display: flex; align-items: center; justify-content: space-between; }
.hotel-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; flex: 1; }
.star-wrap { display: flex; }
.star-dot { font-size: 24rpx; color: #FA8C16; margin-left: 4rpx; }

.hotel-meta { display: flex; align-items: center; margin-top: 12rpx; }
.room-type { font-size: 24rpx; color: #666; }
.meta-sep { color: #d9d9d9; margin: 0 12rpx; }
.meta-tag { font-size: 20rpx; color: #52C41A; background: #F6FFED; padding: 2rpx 12rpx; border-radius: 6rpx; margin-right: 8rpx; }

.hotel-facilities { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.facility-chip { font-size: 20rpx; color: #1BA0D7; background: #E6F4FB; padding: 6rpx 16rpx; border-radius: 6rpx; }

.hotel-intro { font-size: 24rpx; color: #888; margin-top: 16rpx; line-height: 1.6; }

.hotel-price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }
.price-block { display: flex; flex-direction: column; }
.price-label { font-size: 32rpx; color: #FF9F2C; font-weight: 600; }
.price-total { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.select-btn { padding: 12rpx 40rpx; background: #1BA0D7; color: #fff; border-radius: 24rpx; font-size: 26rpx; }
.select-btn.active { background: #BFBFBF; }

/* 底部栏 */
.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
.footer-btn { flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 12rpx; font-size: 30rpx; box-sizing: border-box; }
.footer-btn.delete { background: #FFF1F0; color: #F5222D; }
.footer-btn.share { background: #1BA0D7; color: #fff; padding: 0; margin: 0; border: none; line-height: 88rpx; }
.footer-btn.share::after { border: none; }
